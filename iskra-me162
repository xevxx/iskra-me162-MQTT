import io
import json
import logging
import math
import os
import pickle
import re
import tempfile
import termios
import time
from decimal import Decimal
from pathlib import Path
from types import SimpleNamespace

import paho.mqtt.client as mqtt
import serial


CONFIG_FILE = Path("/etc/default/iskra-me162.config")
SERIAL_TIMEOUT = 30
MQTT_TIMEOUT = 10
LOG = logging.getLogger("iskra-me162")

DEFAULTS = {
    "port": "/dev/ttyUSB0",
    "use_highspeed": False,
    "print_debug": 1,
    "state_file": "/var/run/me162-state",
    "update_interval": 120,
    "msg_prefix": "meter/me162/",
    "broker_address": "",
    "broker_port": 1883,
    "client_name": "CHOICEOFNAME",
    "broker_u": "",
    "broker_p": "",
    "broker_use_userpass": False,
}

ENERGY_FIELDS = {
    "1.8.1": "usage1",
    "1.8.2": "usage2",
    "2.8.1": "return1",
    "2.8.2": "return2",
    "1.8.0": "total_usage",
    "2.8.0": "total_return",
}
ENERGY_VALUE = re.compile(r"([+-]?(?:[0-9]+(?:\.[0-9]*)?|\.[0-9]+))(?:\*kWh)?")
IDENTIFICATION = re.compile(rb"/[A-Z]{3}[0-9][ -~]*")
BAUD_RATES = {"0": 300, "1": 600, "2": 1200, "3": 2400, "4": 4800, "5": 9600, "6": 19200}


class MeterError(Exception):
    pass


class MQTTError(Exception):
    pass


def load_config(path=CONFIG_FILE):
    settings = DEFAULTS.copy()
    exec(compile(path.read_bytes(), str(path), "exec"), settings)
    config = SimpleNamespace(**{key: settings[key] for key in DEFAULTS})
    if not isinstance(config.broker_address, str) or not config.broker_address.strip():
        raise ValueError("Set broker_address to the MQTT broker hostname or IP address")
    if type(config.broker_port) is not int or not 1 <= config.broker_port <= 65535:
        raise ValueError("broker_port must be an integer from 1 through 65535")
    if (type(config.update_interval) not in (int, float)
            or not math.isfinite(config.update_interval) or config.update_interval <= 0):
        raise ValueError("update_interval must be a positive number of seconds")
    return config


def time_remaining(deadline):
    return max(0, deadline - time.monotonic())


def serial_remaining(deadline, phase):
    remaining = time_remaining(deadline)
    if not remaining:
        raise MeterError(f"Timed out during {phase}")
    return remaining


def serial_lines(port, deadline, phase):
    line = bytearray()
    while True:
        remaining = serial_remaining(deadline, phase)
        if port.timeout > remaining:
            port.timeout = remaining
        byte = port.read(1)
        serial_remaining(deadline, phase)
        if byte == b"\n":
            yield bytes(line).rstrip(b"\r")
            line.clear()
        elif byte:
            line.extend(byte)
            if len(line) > 1024:
                raise MeterError(f"Overlong line during {phase}")


def serial_write(port, command, deadline):
    port.write_timeout = serial_remaining(deadline, "serial write")
    if port.write(command) != len(command):
        raise MeterError("Incomplete serial write")


def parse_readings(lines):
    readings = {"time": time.time(), "serial": None}
    for line in lines:
        register, opening, value = line.strip().partition("(")
        if register == "C.1.0" and opening and value.endswith(")"):
            readings["serial"] = value[:-1].strip() or None
        if register not in ENERGY_FIELDS:
            continue
        match = ENERGY_VALUE.fullmatch(value[:-1]) if opening and value.endswith(")") else None
        if match is None or len(match[1]) > 32:
            raise MeterError(f"Invalid value for register {register}")
        energy = Decimal(match[1])
        if energy < 0:
            raise MeterError(f"Negative value for register {register}")
        numerator, denominator = energy.as_integer_ratio()
        field = ENERGY_FIELDS[register]
        if field in readings:
            raise MeterError(f"Duplicate register {register}")
        readings[field] = numerator * 1000 // denominator

    missing = [register for register, field in ENERGY_FIELDS.items() if field not in readings]
    if missing:
        raise MeterError("Missing energy registers " + ", ".join(missing))
    return readings


def read_meter(config):
    deadline = time.monotonic() + SERIAL_TIMEOUT
    with serial.Serial(config.port, baudrate=300, bytesize=serial.SEVENBITS,
                       parity=serial.PARITY_EVEN, stopbits=serial.STOPBITS_ONE,
                       timeout=0.1, write_timeout=SERIAL_TIMEOUT) as port:
        serial_write(port, b"/?!\r\n", deadline)
        for line in serial_lines(port, deadline, "meter identification"):
            if IDENTIFICATION.fullmatch(line):
                break

        speed = chr(line[4]) if config.use_highspeed else "0"
        if speed not in BAUD_RATES:
            speed = "0"
        ack = b"\x060" + speed.encode("ascii") + b"0\r\n"
        sent_at = time.monotonic()
        serial_write(port, ack, deadline)
        if speed != "0":
            # Allow the ACK to leave the transmit queue at the original speed.
            earliest_switch = sent_at + len(ack) * 10 / 300
            while port.out_waiting or time.monotonic() < earliest_switch:
                time.sleep(min(0.01, serial_remaining(deadline, "baud rate change")))
            serial_remaining(deadline, "baud rate change")
            port.baudrate = BAUD_RATES[speed]
        LOG.debug("Reading telegram at %d baud", BAUD_RATES[speed])

        lines = []
        for line in serial_lines(port, deadline, "meter data"):
            if not line or line == ack.rstrip(b"\r\n"):
                continue
            if not lines and line.startswith(b"\x02"):
                line = line[1:]
            if line.strip() == b"!":
                break
            try:
                lines.append(line.decode("ascii"))
            except UnicodeDecodeError as exc:
                raise MeterError("Non-ASCII data in meter telegram") from exc
    return parse_readings(lines)


class LegacyMeterReadings:
    """Container for state written by the original script."""


class LegacyStateUnpickler(pickle.Unpickler):
    def find_class(self, module, name):
        if (module, name) == ("__main__", "MeterReadings"):
            return LegacyMeterReadings
        raise pickle.UnpicklingError("Unexpected class in state file")


def load_baseline(path):
    try:
        with open(path, "rb") as state:
            data = state.read(4097)
        if len(data) > 4096:
            raise ValueError("State file is too large")
        if data.lstrip().startswith(b"{"):
            readings = json.loads(data)
        else:
            readings = vars(LegacyStateUnpickler(io.BytesIO(data)).load())
        timestamp = readings["time"]
        if type(timestamp) not in (int, float) or not math.isfinite(timestamp) or timestamp <= 0:
            raise ValueError("Invalid reading timestamp")
        if readings["serial"] is not None and not isinstance(readings["serial"], str):
            raise ValueError("Invalid meter serial")
        for field in ("total_usage", "total_return"):
            if type(readings[field]) is not int or not 0 <= readings[field] < 10**35:
                raise ValueError("Invalid energy counter")
        return readings
    except FileNotFoundError:
        return None
    except (OSError, ValueError, TypeError, KeyError, OverflowError, EOFError,
            AttributeError, RecursionError, pickle.UnpicklingError) as exc:
        LOG.warning("Cannot load baseline from %s: %s", path, exc)
        return None


def save_baseline(path, readings):
    temp_path = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=Path(path).parent,
                                         prefix=".me162-", delete=False) as state:
            temp_path = state.name
            json.dump(readings, state)
            state.flush()
            os.fsync(state.fileno())
        os.replace(temp_path, path)
        temp_path = None
    except OSError as exc:
        LOG.warning("Cannot save baseline to %s: %s", path, exc)
    finally:
        if temp_path is not None:
            try:
                os.unlink(temp_path)
            except OSError as exc:
                LOG.warning("Cannot remove temporary state file %s: %s", temp_path, exc)


def make_payload(current, previous):
    payload = {field: current[field] / 1000 for field in ENERGY_FIELDS.values()}
    payload.update(consumption=0, production=0)
    if previous is None or current["serial"] != previous["serial"]:
        return payload

    interval = current["time"] - previous["time"]
    imported = current["total_usage"] - previous["total_usage"]
    exported = current["total_return"] - previous["total_return"]
    if interval > 0 and imported >= 0 and exported >= 0:
        payload["consumption"] = int(imported / interval * 3600) / 1000
        payload["production"] = int(exported / interval * 3600) / 1000
    return payload


def check_mqtt_result(result):
    if result != mqtt.MQTT_ERR_SUCCESS:
        raise MQTTError(mqtt.error_string(result))


def run_mqtt_loop(client, deadline, phase):
    remaining = time_remaining(deadline)
    if not remaining:
        raise MQTTError(f"Timed out waiting for {phase}")
    check_mqtt_result(client.loop(timeout=remaining))


def publish(config, payload):
    options = {"client_id": config.client_name, "protocol": mqtt.MQTTv311}
    if hasattr(mqtt, "CallbackAPIVersion"):
        options["callback_api_version"] = mqtt.CallbackAPIVersion.VERSION2
    client = mqtt.Client(**options)
    if config.broker_use_userpass:
        client.username_pw_set(config.broker_u, config.broker_p)

    connection_result = None

    def on_connect(client, userdata, flags, reason_code, properties=None):
        nonlocal connection_result
        connection_result = reason_code

    client.on_connect = on_connect
    try:
        deadline = time.monotonic() + MQTT_TIMEOUT
        check_mqtt_result(client.connect(config.broker_address, port=config.broker_port))
        while connection_result is None:
            run_mqtt_loop(client, deadline, "broker connection")
        if connection_result != 0:
            raise MQTTError(f"Broker rejected connection ({connection_result})")

        deadline = time.monotonic() + MQTT_TIMEOUT
        message = client.publish(config.msg_prefix + "readings", json.dumps(payload), qos=1)
        check_mqtt_result(message.rc)
        while not message.is_published():
            run_mqtt_loop(client, deadline, "publish acknowledgement")
    finally:
        # Close the socket even if a queued DISCONNECT cannot be sent.
        sock = client.socket()
        try:
            client.disconnect()
        finally:
            if sock is not None:
                sock.close()


def poll(config, previous):
    try:
        current = read_meter(config)
    except (OSError, termios.error, MeterError) as exc:
        LOG.warning("Meter read failed: %s", exc)
        return previous
    try:
        payload = make_payload(current, previous)
        LOG.debug("Meter payload %s", payload)
        publish(config, payload)
    except (OSError, MQTTError) as exc:
        LOG.warning("MQTT publish failed: %s", exc)
        return previous
    save_baseline(config.state_file, current)
    LOG.info("Broker acknowledged meter reading")
    return current


def main():
    try:
        config = load_config()
    except (OSError, ValueError, SyntaxError) as exc:
        LOG.error("Cannot load %s: %s", CONFIG_FILE, exc)
        return 1
    level = logging.WARNING if config.print_debug <= 0 else logging.INFO
    if config.print_debug >= 2:
        level = logging.DEBUG
    logging.basicConfig(level=level, format="%(levelname)s %(message)s")

    previous = load_baseline(config.state_file)
    try:
        while True:
            next_poll = time.monotonic() + config.update_interval
            previous = poll(config, previous)
            time.sleep(time_remaining(next_poll))
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
