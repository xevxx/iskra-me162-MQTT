# Optical head settings
port = "/dev/ttyUSB0"
use_highspeed = False

# MQTT settings
broker_address = ""  # Set to your broker's hostname or IP address.
broker_port = 1883
client_name = "iskra-me162"
msg_prefix = "meter/me162/"
broker_use_userpass = False
broker_u = ""
broker_p = ""

# 0 = warnings and errors, 1 = normal logging, 2 = debug logging
print_debug = 1

# Poll interval in seconds. At least 60 seconds is recommended.
update_interval = 120

# Keep the latest acknowledged reading on tmpfs to avoid SD card writes.
state_file = "/var/run/me162-state"
